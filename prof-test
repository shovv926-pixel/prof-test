let currentQuestion = 0;
let selectedAnswer = null;

let scores = {
  psychologist: 0,
  humanities: 0,
  artist: 0,
  physicist: 0
};


/* ==========================================
   ПОКАЗ ВОПРОСА
========================================== */

function showQuestion() {

  const question = questions[currentQuestion];

  document.getElementById("progress").innerText =
    "Вопрос " + (currentQuestion + 1) + " из " + questions.length;

  let html = "";

  html += '<div class="question">';
  html += '<div class="question-title">' + question.text + '</div>';

  question.answers.forEach(function(answer, index) {

    html +=
      '<button class="answer" onclick="selectAnswer(' +
      index +
      ')">' +
      '<strong>' + answer[0] + ")</strong> " +
      answer[1] +
      '</button>';

  });

  html += '</div>';

  document.getElementById("question-container").innerHTML = html;

  document.getElementById("next-btn").disabled = true;

  selectedAnswer = null;

  if (currentQuestion === questions.length - 1) {
    document.getElementById("next-btn").innerText =
      "Получить результат";
  } else {
    document.getElementById("next-btn").innerText =
      "Далее";
  }

}


/* ==========================================
   ВЫБОР ОТВЕТА
========================================== */

function selectAnswer(index) {

  selectedAnswer = index;

  const buttons =
    document.querySelectorAll(".answer");

  buttons.forEach(function(button) {
    button.classList.remove("selected");
  });

  buttons[index].classList.add("selected");

  document.getElementById("next-btn").disabled = false;

}


/* ==========================================
   КНОПКА "ДАЛЕЕ"
========================================== */

document.getElementById("next-btn").addEventListener(
  "click",
  function() {

    if (selectedAnswer === null) {
      return;
    }

    /*
      Получаем тип выбранного ответа
      из таблицы mapping.
    */

    const type =
      mapping[currentQuestion][selectedAnswer];

    scores[type]++;

    if (currentQuestion < questions.length - 1) {

      currentQuestion++;

      showQuestion();

    } else {

      showResult();

    }

  }
);


/* ==========================================
   ПОКАЗ РЕЗУЛЬТАТА
========================================== */

function showResult() {

  document.querySelector(".test-header").style.display =
    "none";

  document.getElementById("question-container").style.display =
    "none";

  document.getElementById("next-btn").style.display =
    "none";


  /*
    Находим максимальное количество баллов.
  */

  const maxScore = Math.max(
    scores.psychologist,
    scores.humanities,
    scores.artist,
    scores.physicist
  );


  /*
    Определяем все профили,
    которые набрали максимальный балл.
  */

  let winners = [];

  Object.keys(scores).forEach(function(type) {

    if (scores[type] === maxScore) {
      winners.push(type);
    }

  });


  let resultHTML = "";

  resultHTML +=
    '<div class="result-label">Твой результат</div>';


  /*
    Если один победитель
  */

  if (winners.length === 1) {

    const winner = winners[0];

    resultHTML +=
      '<div class="result-title">' +
      profiles[winner].name +
      '</div>';

    resultHTML +=
      '<div class="result-description">' +
      '<strong>' +
      profiles[winner].icon +
      '</strong><br><br>' +
      profiles[winner].description +
      '<br><br>' +
      '<strong>Возможные направления:</strong><br>' +
      profiles[winner].professions +
      '</div>';

  }


  /*
    Если несколько профилей набрали одинаковое
    максимальное количество баллов
  */

  else {

    resultHTML +=
      '<div class="result-title">' +
      'Несколько подходящих направлений' +
      '</div>';

    resultHTML +=
      '<div class="result-description">' +
      'Твои ответы показывают интерес сразу к нескольким направлениям:<br><br>';

    winners.forEach(function(type) {

      resultHTML +=
        '<strong>' +
        profiles[type].name +
        '</strong><br>' +
        profiles[type].description +
        '<br><br>';

    });

    resultHTML += '</div>';

  }


  /*
    Показываем все баллы.
  */

  resultHTML +=
    '<div class="scores-title">Распределение баллов</div>';


  resultHTML +=
    '<div class="score-row">' +
    '<span>Психолог</span>' +
    '<strong>' +
    scores.psychologist +
    '</strong>' +
    '</div>';

  resultHTML +=
    '<div class="score-row">' +
    '<span>Гуманитарий</span>' +
    '<strong>' +
    scores.humanities +
    '</strong>' +
    '</div>';

  resultHTML +=
    '<div class="score-row">' +
    '<span>Художник</span>' +
    '<strong>' +
    scores.artist +
    '</strong>' +
    '</div>';

  resultHTML +=
    '<div class="score-row">' +
    '<span>Физик</span>' +
    '<strong>' +
    scores.physicist +
    '</strong>' +
    '</div>';


  resultHTML +=
    '<button class="restart-btn" onclick="restartTest()">' +
    'Пройти тест ещё раз' +
    '</button>';


  document.getElementById("result-container").innerHTML =
    resultHTML;

  document.getElementById("result-container").style.display =
    "block";

}


/* ==========================================
   ПОВТОРНОЕ ПРОХОЖДЕНИЕ
========================================== */

function restartTest() {

  currentQuestion = 0;
  selectedAnswer = null;

  scores = {
    psychologist: 0,
    humanities: 0,
    artist: 0,
    physicist: 0
  };

  document.querySelector(".test-header").style.display =
    "block";

  document.getElementById("question-container").style.display =
    "block";

  document.getElementById("next-btn").style.display =
    "inline-block";

  document.getElementById("result-container").style.display =
    "none";

  showQuestion();

}


